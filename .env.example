# Copy this file to .env and fill in the values you need.
# Every variable here is optional — the app runs without any of them.

# Speaker diarization (transcription.py). Needs a Hugging Face token with
# access to pyannote/speaker-diarization-3.1, plus `pip install pyannote.audio`.
HF_TOKEN=

# Real JIRA task creation (meeting_assistant.py). All four must be set to
# leave mock mode — otherwise JiraTaskTool returns a simulated key like KAN-123.
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=

# Force mock JIRA responses even if the four credentials above are set.
JIRA_MOCK_MODE=false

# Require this password before the Streamlit UI is shown. The app has no
# other authentication — without this, only run it on localhost.
APP_PASSWORD=
